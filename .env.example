# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored and never enters the container image: the key stays on your machine.
# The API reads it when it starts (uv run spherex-ingest serve).

# Your Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults shown.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Caps that keep the sky guide inside the Gemini free tier (see docs/CLOUD-RUN.md).
# ASSISTANT_PER_CLIENT_PER_MINUTE=4
# ASSISTANT_GLOBAL_PER_MINUTE=10
# ASSISTANT_DAILY_LIMIT=200
